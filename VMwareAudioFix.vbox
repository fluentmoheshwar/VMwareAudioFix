      <Network>
        <Adapter slot="0" cable="false">
          <DisabledModes>
            <InternalNetwork name="intnet"/>
            <NATNetwork name="NatNetwork"/>
          </DisabledModes>
        </Adapter>
      </Network>
      <AudioAdapter driver="Null"/>
      <Clipboard/>
      <CPU executionCap="1">
        <HardwareVirtExLargePages enabled="false"/>
        <HardwareVirtExNestedPaging enabled="false"/>
        <PAE enabled="false"/>
        <LongMode enabled="false"/>
      </CPU>
    </Hardware>
  </Machine>
