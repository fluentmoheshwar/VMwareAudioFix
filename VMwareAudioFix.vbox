    <Hardware>
      <Memory RAMSize="4"/>
      <Paravirt provider="None"/>
      <Display controller="None" VRAMSize="0"/>
      <Firmware/>
      <BIOS>
        <SmbiosUuidLittleEndian enabled="true"/>
        <AutoSerialNumGen enabled="true"/>
